FROM python:3.12-slim

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency files first — Docker caches this layer
# Only re-runs when pyproject.toml or uv.lock changes, not on every code change
COPY pyproject.toml uv.lock ./

# Install all dependencies (including dev), but skip the project itself for now
RUN uv sync --frozen --group dev --no-install-project

# Copy application source
# In development this directory is mounted as a volume,
# so changes to app/ are reflected immediately without rebuilding
COPY . .

# Install the project itself to finalize editable mode
RUN uv sync --frozen --group dev

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

EXPOSE 8000

CMD ["uvicorn", "app.main:app", \
    "--host", "0.0.0.0", \
    "--port", "8000", \
    "--reload", \
    "--reload-dir", "app"]
