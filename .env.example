# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
APP_NAME="SpendWise"
APP_VERSION="1.0.0"
DEBUG=true
API_V1_PREFIX="/api/v1"
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ─────────────────────────────────────────
# Database (PostgreSQL)
# ─────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL="postgresql+asyncpg://spendwise:spendwise_dev_password@localhost:5432/spendwise"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ─────────────────────────────────────────
# Redis & Celery
# ─────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# ─────────────────────────────────────────
# Security — JWT
# ─────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="CHANGE_ME_generate_a_real_64_char_hex_string"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─────────────────────────────────────────
# Google OAuth2 (optional — leave blank to disable)
# ─────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"

# ─────────────────────────────────────────
# Email (optional — for verification emails)
# ─────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@spendwise.local"
EMAILS_FROM_NAME="SpendWise"
